# Copy to .env and set FLEET_EMAIL and FLEET_PASSWORD. Do not commit .env.
BASE_URL=http://localhost:1337
FLEET_EMAIL=
FLEET_PASSWORD=
# Minimum number of enrolled hosts global setup waits for before running tests
MIN_HOSTS=2
# How long global setup waits for Fleet, hosts, and software on the Linux host (ms)
READINESS_TIMEOUT_MS=180000
# Parallel workers. Default in src/config/env.ts is 2. The suite shares one Fleet user.
WORKERS=2
