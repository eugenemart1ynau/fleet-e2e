{
  "name": "fleet-e2e",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Playwright + TypeScript E2E tests for Fleet Hosts and Host details pages (fleetctl preview)",
  "scripts": {
    "test": "sh scripts/playwright.sh",
    "test:headed": "sh scripts/playwright.sh --headed --workers=1",
    "test:ui": "sh scripts/playwright.sh --ui",
    "test:smoke": "sh scripts/playwright.sh --grep @smoke",
    "test:ui:smoke": "sh scripts/playwright.sh tests/ui/smoke --project=chrome --project=firefox --project=safari",
    "test:ui:regression": "sh scripts/playwright.sh tests/ui/regression --project=chrome --project=firefox --project=safari",
    "test:ui:e2e": "sh scripts/playwright.sh tests/ui/e2e --project=chrome --project=firefox --project=safari",
    "test:destructive": "sh scripts/playwright.sh --project=destructive",
    "test:api": "sh scripts/playwright.sh --project=api",
    "test:api:smoke": "sh scripts/playwright.sh --project=api --grep @smoke",
    "test:api:regression": "sh scripts/playwright.sh --project=api --grep @regression",
    "test:api:destructive": "sh scripts/playwright.sh --project=api-destructive --no-deps",
    "test:ui-only": "sh scripts/playwright.sh --project=chrome --project=firefox --project=safari --project=destructive",
    "coverage": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/coverage/build.ts",
    "coverage:shots": "sh scripts/playwright.sh --config=tools/coverage/playwright.capture.config.ts && node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/coverage/build.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}
