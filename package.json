{
  "name": "fleet-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript E2E tests for Fleet Hosts and Host details pages (fleetctl preview)",
  "scripts": {
    "test": "FORCE_COLOR=1 playwright test",
    "test:headed": "FORCE_COLOR=1 playwright test --headed",
    "test:ui": "FORCE_COLOR=1 playwright test --ui",
    "test:smoke": "FORCE_COLOR=1 playwright test --grep @smoke",
    "test:ui:smoke": "FORCE_COLOR=1 playwright test tests/ui/smoke --project=chrome --project=firefox --project=safari",
    "test:ui:regression": "FORCE_COLOR=1 playwright test tests/ui/regression --project=chrome --project=firefox --project=safari",
    "test:ui:e2e": "FORCE_COLOR=1 playwright test tests/ui/e2e --project=chrome --project=firefox --project=safari",
    "test:destructive": "FORCE_COLOR=1 playwright test --project=destructive",
    "test:api": "FORCE_COLOR=1 playwright test --project=api",
    "test:api:smoke": "FORCE_COLOR=1 playwright test --project=api --grep @smoke",
    "test:api:regression": "FORCE_COLOR=1 playwright test --project=api --grep @regression",
    "test:api:destructive": "FORCE_COLOR=1 playwright test --project=api-destructive --no-deps",
    "test:ui-only": "FORCE_COLOR=1 playwright test --project=chrome --project=firefox --project=safari --project=destructive",
    "coverage": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/coverage/build.ts",
    "coverage:shots": "FORCE_COLOR=1 playwright test --config=tools/coverage/playwright.capture.config.ts && node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/coverage/build.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
